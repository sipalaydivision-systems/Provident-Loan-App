# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL). On Railway set DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:your_password@localhost:5432/provident_loan_db

# Initial admin password (the 'admin' user's password is kept in sync with this value)
ADMIN_PASSWORD=change_me

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# Admin Email for notifications
ADMIN_EMAIL=admin@providentloan.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# CORS
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret
